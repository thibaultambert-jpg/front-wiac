# --- Dendreo (lu uniquement côté serveur) ---
DENDREO_SLUG=
DENDREO_API_KEY=
# Entreprise Dendreo à laquelle rattacher les internes (Wivoo = 170)
DENDREO_ID_ENTREPRISE=170
# Étapes Dendreo (id_etape_process) à masquer dans le catalogue, séparées par des virgules (optionnel)
DENDREO_ETAPES_MASQUEES=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé service : serveur uniquement, jamais exposée au navigateur
SUPABASE_SERVICE_ROLE_KEY=

# --- Accès ---
# Domaine Google Workspace autorisé
GOOGLE_WORKSPACE_DOMAIN=wivoo.fr
# Emails promus administrateurs à la connexion (séparés par des virgules)
ADMIN_EMAILS=
# Adresse publique du site (liens dans les emails, redirection OAuth)
PUBLIC_URL=http://localhost:3000

# --- Cron Vercel (synchronisation quotidienne des modules) ---
CRON_SECRET=
